# Supabase Postgres
# Dashboard → Connect → Transaction pooler (port 6543)
DATABASE_URL="postgresql://prisma.[PROJECT_REF]:[PRISMA_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Dashboard → Connect → Session pooler (port 5432). Used by Prisma migrate/seed/studio.
DIRECT_URL="postgresql://prisma.[PROJECT_REF]:[PRISMA_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# AWS S3 (optional in development — files are stored locally if unset)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="school-erp-files"

# Server
PORT=3000
NODE_ENV="development"
CLIENT_URL="http://localhost:8081"

# OTP (development returns the OTP in the API response)
OTP_EXPIRES_MINUTES="10"
